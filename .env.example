# Karuth configuration template.
#
# Copy this file to `.env` (git-ignored) and fill in your values. Real
# environment variables always take precedence over `.env` values.
# NEVER put a real key in this template file - it is committed to git.

# --- OpenRouter (default planning backend) ---
# The only required secret. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults shown):
KARUTH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free tier. If a specific free slug is retired by OpenRouter, use the
# `openrouter/free` router slug or pick another from the /api/v1/models list.
KARUTH_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
KARUTH_OPENROUTER_TEMPERATURE=0.0
KARUTH_OPENROUTER_MAX_TOKENS=2048
# Short timeout so an unreachable LLM endpoint falls back to deterministic
# mode quickly instead of stalling the investigation.
KARUTH_OPENROUTER_TIMEOUT=20.0

# --- LM Studio (fully offline LLM backend) ---
KARUTH_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Empty = auto-discover the first loaded chat-capable model on the server.
KARUTH_LMSTUDIO_MODEL=
KARUTH_LMSTUDIO_TEMPERATURE=0.0
KARUTH_LMSTUDIO_MAX_TOKENS=1024
KARUTH_LMSTUDIO_TIMEOUT=20.0

# --- Vision transcription (LM Studio vision model) ---
# Empty = auto-discover a vision-capable model on the LM Studio server.
KARUTH_VISION_MODEL=

# --- Neo4j graph (best-effort enrichment; pipeline works without it) ---
KARUTH_NEO4J_URI=bolt://localhost:7687
KARUTH_NEO4J_USER=neo4j
KARUTH_NEO4J_PASSWORD=karuth-local-only
KARUTH_NEO4J_ENABLED=1

# --- Dynamic hypothesis loop (agentic mode) ---
# Maximum autonomous actions before the loop is forced to finalize.
KARUTH_DYNAMIC_MAX_ACTIONS=12
# Maximum hypotheses kept per investigation.
KARUTH_MAX_HYPOTHESES=8
# Confidence above which a supported hypothesis triggers the skeptic stage.
KARUTH_SKEPTIC_CONFIDENCE_THRESHOLD=0.8
# Minimum expected information gain before the loop keeps going.
KARUTH_INFO_GAIN_THRESHOLD=0.25
# Confidence at/above which final decisions require human review.
KARUTH_HUMAN_REVIEW_THRESHOLD=0.7

# --- Storage ---
KARUTH_DATA_DIR=.karuth-data
KARUTH_LEDGER_DB=.karuth-data/ledger.sqlite3
